# Database (matches docker-compose.yml at the repository root)
DATABASE_URL="postgresql://learnova:password@localhost:5432/learnova?schema=public"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
